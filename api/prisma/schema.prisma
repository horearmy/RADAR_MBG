generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

model Organization {
  id                String                    @id @default(uuid()) @db.Uuid
  code              String                    @unique @db.VarChar(32)
  name              String                    @db.VarChar(160)
  active            Boolean                   @default(true)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deliveryLocations DeliveryLocation[]
  assignments       DriverVehicleAssignment[]
  exceptionCases    ExceptionCase[]
  regions           Region[]
  sppgs             Sppg[]
  trips             Trip[]
  roles             UserRole[]
  vehicles          Vehicle[]

  @@map("organizations")
}

model Region {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  code              String             @db.VarChar(32)
  name              String             @db.VarChar(160)
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  deliveryLocations DeliveryLocation[]
  exceptionCases    ExceptionCase[]
  organization      Organization       @relation(fields: [organizationId], references: [id])
  sppgs             Sppg[]
  memberships       UserRole[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@map("regions")
}

model Sppg {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  regionId       String                    @map("region_id") @db.Uuid
  code           String                    @db.VarChar(32)
  name           String                    @db.VarChar(160)
  address        String?                   @db.VarChar(500)
  latitude       Decimal?                  @db.Decimal(9, 6)
  longitude      Decimal?                  @db.Decimal(9, 6)
  coordinates    Unsupported("geography")?
  status         SppgStatus                @default(PENDING)
  version        Int                       @default(1)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignments    DriverVehicleAssignment[]
  drivers        Driver[]
  exceptionCases ExceptionCase[]
  geofences      Geofence[]
  routesFrom     Route[]                   @relation("RouteOrigin")
  organization   Organization              @relation(fields: [organizationId], references: [id])
  region         Region                    @relation(fields: [regionId], references: [id])
  tripsFrom      Trip[]                    @relation("TripOrigin")
  memberships    UserRole[]
  vehicles       Vehicle[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([regionId, status])
  @@index([coordinates], type: Gist)
  @@map("sppgs")
}

model User {
  id                             String                         @id @default(uuid()) @db.Uuid
  username                       String                         @unique @db.VarChar(80)
  email                          String?                        @unique @db.VarChar(254)
  displayName                    String                         @map("display_name") @db.VarChar(160)
  passwordHash                   String                         @map("password_hash") @db.VarChar(255)
  status                         AccountStatus                  @default(INVITED)
  mfaEnabled                     Boolean                        @default(false) @map("mfa_enabled")
  mfaSecretEncrypted             String?                        @map("mfa_secret_encrypted") @db.VarChar(512)
  passwordChangedAt              DateTime?                      @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt                    DateTime?                      @map("last_login_at") @db.Timestamptz(6)
  createdAt                      DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                      DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(6)
  disabledAt                     DateTime?                      @map("disabled_at") @db.Timestamptz(6)
  mfaPendingSecretEncrypted      String?                        @map("mfa_pending_secret_encrypted") @db.VarChar(512)
  mfaPendingExpiresAt            DateTime?                      @map("mfa_pending_expires_at") @db.Timestamptz(6)
  features                       Json?                          @map("features") @db.Json
  accountTokensCreated           AccountAccessToken[]           @relation("AccountTokenCreator")
  accountTokens                  AccountAccessToken[]           @relation("AccountTokenUser")
  approvalDecisions              ApprovalDecision[]             @relation("ApprovalApprover")
  approvalRequests               ApprovalRequest[]              @relation("ApprovalRequester")
  assignmentsCreated             DriverVehicleAssignment[]      @relation("AssignmentCreatedBy")
  driver                         Driver?
  mfaRecoveryCodes               MfaRecoveryCode[]
  routes                         Route[]
  sessions                       Session[]
  tenantMemberships              TenantMembership[]
  recipientMemberships           RecipientMembership[]
  reviewedRecipientRegistrations RecipientRegistrationRequest[] @relation("RecipientRegistrationReviewer")
  notificationEvents             NotificationEvent[]
  tripsCreated                   Trip[]                         @relation("TripCreatedBy")
  roles                          UserRole[]

  @@index([status])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(64)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(500)
  isGlobal    Boolean          @default(false) @map("is_global")
  requiresMfa Boolean          @default(false) @map("requires_mfa")
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(300)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  roleId         String        @map("role_id") @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  regionId       String?       @map("region_id") @db.Uuid
  sppgId         String?       @map("sppg_id") @db.Uuid
  assignedBy     String?       @map("assigned_by") @db.Uuid
  effectiveFrom  DateTime      @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveUntil DateTime?     @map("effective_until") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  region         Region?       @relation(fields: [regionId], references: [id], onDelete: Restrict)
  role           Role          @relation(fields: [roleId], references: [id])
  sppg           Sppg?         @relation(fields: [sppgId], references: [id], onDelete: Restrict)
  user           User          @relation(fields: [userId], references: [id])

  @@index([userId, effectiveUntil])
  @@index([sppgId, roleId])
  @@index([organizationId, regionId])
  @@map("user_roles")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress  String?   @map("ip_address") @db.Inet
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([revokedAt, expiresAt])
  @@map("sessions")
}

model AccountAccessToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(128)
  purpose    String    @db.VarChar(32)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdBy  String    @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  creator    User      @relation("AccountTokenCreator", fields: [createdBy], references: [id])
  user       User      @relation("AccountTokenUser", fields: [userId], references: [id])

  @@index([userId, purpose, expiresAt])
  @@index([consumedAt, expiresAt])
  @@map("account_access_tokens")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

model ApprovalRequest {
  id            String             @id @default(uuid()) @db.Uuid
  actionType    String             @map("action_type") @db.VarChar(100)
  targetType    String             @map("target_type") @db.VarChar(100)
  targetId      String             @map("target_id") @db.VarChar(100)
  requestedBy   String             @map("requested_by") @db.Uuid
  reason        String             @db.VarChar(2000)
  payloadBefore Json?              @map("payload_before")
  payloadAfter  Json               @map("payload_after")
  status        ApprovalStatus     @default(DRAFT)
  objectVersion Int?               @map("object_version")
  submittedAt   DateTime?          @map("submitted_at") @db.Timestamptz(6)
  expiresAt     DateTime?          @map("expires_at") @db.Timestamptz(6)
  executedAt    DateTime?          @map("executed_at") @db.Timestamptz(6)
  correlationId String?            @map("correlation_id") @db.VarChar(100)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  decisions     ApprovalDecision[]
  requester     User               @relation("ApprovalRequester", fields: [requestedBy], references: [id])

  @@index([status, submittedAt])
  @@index([targetType, targetId])
  @@index([requestedBy, createdAt])
  @@map("approval_requests")
}

model ApprovalDecision {
  id                String          @id @default(uuid()) @db.Uuid
  approvalRequestId String          @map("approval_request_id") @db.Uuid
  approverId        String          @map("approver_id") @db.Uuid
  decision          String          @db.VarChar(32)
  reason            String?         @db.VarChar(2000)
  decidedAt         DateTime        @default(now()) @map("decided_at") @db.Timestamptz(6)
  approvalRequest   ApprovalRequest @relation(fields: [approvalRequestId], references: [id])
  approver          User            @relation("ApprovalApprover", fields: [approverId], references: [id])

  @@index([approvalRequestId, decidedAt])
  @@index([approverId, decidedAt])
  @@map("approval_decisions")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(120)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.VarChar(100)
  result      String   @db.VarChar(32)
  reason      String?  @db.VarChar(2000)
  before      Json?
  after       Json?
  requestId   String?  @map("request_id") @db.VarChar(100)
  ipAddress   String?  @map("ip_address") @db.Inet
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenantId    String?  @map("tenant_id") @db.Uuid

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Driver {
  id                  String                    @id @default(uuid()) @db.Uuid
  sppgId              String                    @map("sppg_id") @db.Uuid
  userId              String?                   @unique @map("user_id") @db.Uuid
  code                String                    @db.VarChar(32)
  name                String                    @db.VarChar(160)
  phone               String?                   @db.VarChar(32)
  status              DriverStatus              @default(ACTIVE)
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantId            String                    @map("tenant_id") @db.Uuid
  assignments         DriverVehicleAssignment[]
  deliveryAssignments DeliveryAssignment[]
  locationEvents      LocationEvent[]
  sppg                Sppg                      @relation(fields: [sppgId], references: [id])
  user                User?                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  trips               Trip[]

  @@unique([sppgId, code])
  @@index([sppgId, status])
  @@map("drivers")
}

model Vehicle {
  id                  String                    @id @default(uuid()) @db.Uuid
  organizationId      String                    @map("organization_id") @db.Uuid
  sppgId              String                    @map("sppg_id") @db.Uuid
  plateNumber         String                    @unique @map("plate_number") @db.VarChar(20)
  label               String?                   @db.VarChar(100)
  capacity            Int?
  status              VehicleStatus             @default(ACTIVE)
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantId            String                    @map("tenant_id") @db.Uuid
  assignments         DriverVehicleAssignment[]
  deliveryAssignments DeliveryAssignment[]
  trips               Trip[]
  organization        Organization              @relation(fields: [organizationId], references: [id])
  sppg                Sppg                      @relation(fields: [sppgId], references: [id])

  @@index([organizationId, status])
  @@index([sppgId, status])
  @@map("vehicles")
}

model DriverVehicleAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  sppgId         String       @map("sppg_id") @db.Uuid
  driverId       String       @map("driver_id") @db.Uuid
  vehicleId      String       @map("vehicle_id") @db.Uuid
  effectiveFrom  DateTime     @map("effective_from") @db.Timestamptz(6)
  effectiveTo    DateTime?    @map("effective_to") @db.Timestamptz(6)
  reason         String       @db.VarChar(2000)
  createdBy      String       @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  creator        User         @relation("AssignmentCreatedBy", fields: [createdBy], references: [id])
  driver         Driver       @relation(fields: [driverId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  sppg           Sppg         @relation(fields: [sppgId], references: [id])
  vehicle        Vehicle      @relation(fields: [vehicleId], references: [id])

  @@index([driverId, effectiveFrom])
  @@index([vehicleId, effectiveFrom])
  @@index([sppgId, effectiveFrom])
  @@map("driver_vehicle_assignments")
}

model DeliveryLocation {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  regionId       String                    @map("region_id") @db.Uuid
  code           String                    @db.VarChar(32)
  name           String                    @db.VarChar(160)
  address        String?                   @db.VarChar(500)
  latitude       Decimal?                  @db.Decimal(9, 6)
  longitude      Decimal?                  @db.Decimal(9, 6)
  coordinates    Unsupported("geography")?
  active         Boolean                   @default(true)
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantId       String?                   @map("tenant_id") @db.Uuid
  organization   Organization              @relation(fields: [organizationId], references: [id])
  region         Region                    @relation(fields: [regionId], references: [id])
  geofences      Geofence[]
  qrTokens       QrToken[]
  routes         Route[]                   @relation("RouteDestination")
  trips          Trip[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@index([regionId, active])
  @@index([coordinates], type: Gist)
  @@map("delivery_locations")
}

model Trip {
  id                   String                    @id @default(uuid()) @db.Uuid
  organizationId       String                    @map("organization_id") @db.Uuid
  sppgId               String                    @map("sppg_id") @db.Uuid
  deliveryLocationId   String                    @map("delivery_location_id") @db.Uuid
  vehicleId            String                    @map("vehicle_id") @db.Uuid
  driverId             String                    @map("driver_id") @db.Uuid
  createdBy            String                    @map("created_by") @db.Uuid
  idempotencyKey       String?                   @unique @map("idempotency_key") @db.VarChar(128)
  plannedDepartureAt   DateTime                  @map("planned_departure_at") @db.Timestamptz(6)
  plannedArrivalAt     DateTime                  @map("planned_arrival_at") @db.Timestamptz(6)
  actualDepartureAt    DateTime?                 @map("actual_departure_at") @db.Timestamptz(6)
  arrivalDetectedAt    DateTime?                 @map("arrival_detected_at") @db.Timestamptz(6)
  arrivalVerifiedAt    DateTime?                 @map("arrival_verified_at") @db.Timestamptz(6)
  deliveryStartedAt    DateTime?                 @map("delivery_started_at") @db.Timestamptz(6)
  deliveredAt          DateTime?                 @map("delivered_at") @db.Timestamptz(6)
  completedAt          DateTime?                 @map("completed_at") @db.Timestamptz(6)
  status               TripStatus                @default(DRAFT)
  trackingStatus       TrackingStatus            @default(OFFLINE) @map("tracking_status")
  verificationStatus   ArrivalVerificationStatus @default(NOT_STARTED) @map("verification_status")
  deliveryStatus       DeliveryStatus            @default(NOT_STARTED) @map("delivery_status")
  plannedQuantity      Int                       @map("planned_quantity")
  dispatchedQuantity   Int?                      @map("dispatched_quantity")
  receivedQuantity     Int?                      @map("received_quantity")
  version              Int                       @default(1)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenantId             String                    @map("tenant_id") @db.Uuid
  arrivalOverrides     ArrivalOverride[]
  arrivalVerifications ArrivalVerification[]
  deliveryRecords      DeliveryRecord[]
  exceptionCases       ExceptionCase[]
  positions            GpsPosition[]
  qrTokens             QrToken[]
  events               TripEvent[]
  creator              User                      @relation("TripCreatedBy", fields: [createdBy], references: [id])
  deliveryLocation     DeliveryLocation          @relation(fields: [deliveryLocationId], references: [id])
  driver               Driver                    @relation(fields: [driverId], references: [id])
  organization         Organization              @relation(fields: [organizationId], references: [id])
  sppg                 Sppg                      @relation("TripOrigin", fields: [sppgId], references: [id])
  vehicle              Vehicle                   @relation(fields: [vehicleId], references: [id])
  deliveryStops        DeliveryStop[]
  deliveryAssignments  DeliveryAssignment[]
  locationEvents       LocationEvent[]
  geofenceEvents       GeofenceEvent[]

  @@index([organizationId, status, plannedDepartureAt])
  @@index([sppgId, plannedDepartureAt])
  @@index([deliveryLocationId, plannedArrivalAt])
  @@index([driverId, status])
  @@index([vehicleId, status])
  @@map("trips")
}

model GpsPosition {
  id               String   @id @default(uuid()) @db.Uuid
  tripId           String   @map("trip_id") @db.Uuid
  latitude         Decimal  @db.Decimal(9, 6)
  longitude        Decimal  @db.Decimal(9, 6)
  accuracyMeters   Decimal? @map("gps_accuracy_m") @db.Decimal(8, 2)
  speedMps         Decimal? @map("speed_mps") @db.Decimal(8, 2)
  headingDegrees   Decimal? @map("heading_deg") @db.Decimal(6, 2)
  deviceTimestamp  DateTime @map("device_timestamp") @db.Timestamptz(6)
  serverReceivedAt DateTime @default(now()) @map("server_received_at") @db.Timestamptz(6)
  sequenceNumber   Int?     @map("sequence_number")
  deviceId         String?  @map("device_id") @db.VarChar(100)
  source           String   @db.VarChar(32)
  integrityFlags   Json     @default("[]") @map("integrity_flags")
  idempotencyKey   String   @map("idempotency_key") @db.VarChar(128)
  trip             Trip     @relation(fields: [tripId], references: [id])

  @@unique([tripId, idempotencyKey])
  @@index([tripId, deviceTimestamp])
  @@index([tripId, serverReceivedAt])
  @@map("gps_positions")
}

model TripEvent {
  id              String    @id @default(uuid()) @db.Uuid
  tripId          String    @map("trip_id") @db.Uuid
  actorUserId     String?   @map("actor_user_id") @db.Uuid
  eventType       String    @map("event_type") @db.VarChar(100)
  fromStatus      String?   @map("from_status") @db.VarChar(40)
  toStatus        String?   @map("to_status") @db.VarChar(40)
  reason          String?   @db.VarChar(2000)
  deviceTimestamp DateTime? @map("device_timestamp") @db.Timestamptz(6)
  occurredAt      DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  metadata        Json?
  idempotencyKey  String?   @map("idempotency_key") @db.VarChar(128)
  trip            Trip      @relation(fields: [tripId], references: [id])

  @@unique([tripId, idempotencyKey])
  @@index([tripId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("trip_events")
}

model Geofence {
  id                          String                    @id @default(uuid()) @db.Uuid
  sppgId                      String?                   @map("sppg_id") @db.Uuid
  deliveryLocationId          String?                   @map("delivery_location_id") @db.Uuid
  type                        GeofenceType
  name                        String                    @db.VarChar(160)
  centerLatitude              Decimal?                  @map("center_latitude") @db.Decimal(9, 6)
  centerLongitude             Decimal?                  @map("center_longitude") @db.Decimal(9, 6)
  center                      Unsupported("geography")?
  radiusMeters                Decimal?                  @map("radius_meters") @db.Decimal(8, 2)
  minGpsAccuracyMeters        Decimal                   @default(50) @map("min_gps_accuracy_m") @db.Decimal(8, 2)
  confirmationFixes           Int                       @default(2) @map("confirmation_fixes")
  confirmationDurationSeconds Int                       @default(10) @map("confirmation_duration_seconds")
  idempotencyKey              String?                   @unique @map("idempotency_key") @db.VarChar(128)
  active                      Boolean                   @default(true)
  version                     Int                       @default(1)
  createdBy                   String                    @map("created_by") @db.Uuid
  createdAt                   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  shapeType                   String                    @default("CIRCLE") @map("shape_type") @db.VarChar(20)
  polygonCoordinates          Json?                     @map("polygon_coordinates")
  tenantId                    String?                   @map("tenant_id") @db.Uuid
  deliveryLocation            DeliveryLocation?         @relation(fields: [deliveryLocationId], references: [id], onDelete: Restrict)
  sppg                        Sppg?                     @relation(fields: [sppgId], references: [id], onDelete: Restrict)

  @@index([sppgId, active, version])
  @@index([deliveryLocationId, active, version])
  @@index([center], type: Gist)
  @@map("geofences")
}

model Route {
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sppgId                   String           @map("sppg_id") @db.Uuid
