  code         RecipientRegistrationCode? @relation(fields: [registrationCodeId], references: [id])
  reviewer     User?                      @relation("RecipientRegistrationReviewer", fields: [reviewedByUserId], references: [id])
  approvedSite RecipientSite?             @relation(fields: [approvedRecipientSiteId], references: [id])

  @@index([tenantId, status])
  @@index([registrationCodeId])
  @@map("recipient_registration_requests")
}

model DeliveryStop {
  id               String    @id @default(uuid()) @db.Uuid
  tripId           String    @map("trip_id") @db.Uuid
  recipientSiteId  String    @map("recipient_site_id") @db.Uuid
  sequenceNumber   Int       @map("sequence_number")
  plannedArrivalAt DateTime? @map("planned_arrival_at") @db.Timestamptz(6)
  status           String    @default("PENDING") @db.VarChar(32)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip Trip          @relation(fields: [tripId], references: [id])
  site RecipientSite @relation(fields: [recipientSiteId], references: [id])

  geofenceEvents GeofenceEvent[]

  @@map("delivery_stops")
}

model DeliveryAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  driverId  String   @map("driver_id") @db.Uuid
  vehicleId String   @map("vehicle_id") @db.Uuid
  status    String   @default("ASSIGNED") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  trip    Trip    @relation(fields: [tripId], references: [id])
  driver  Driver  @relation(fields: [driverId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@map("delivery_assignments")
}

model LocationEvent {
  id             String   @id @default(uuid()) @db.Uuid
  tripId         String   @map("trip_id") @db.Uuid
  driverId       String   @map("driver_id") @db.Uuid
  latitude       Decimal  @db.Decimal(9, 6)
  longitude      Decimal  @db.Decimal(9, 6)
  accuracyM      Decimal? @map("accuracy_m") @db.Decimal(6, 2)
  speedMps       Decimal? @map("speed_mps") @db.Decimal(6, 2)
  sequenceNumber Int      @map("sequence_number")
  recordedAt     DateTime @map("recorded_at") @db.Timestamptz(6)
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  trip   Trip   @relation(fields: [tripId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([tripId, sequenceNumber])
  @@index([tripId, recordedAt])
  @@map("location_events")
}

model GeofenceEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  stopId    String   @map("stop_id") @db.Uuid
  eventType String   @map("event_type") @db.VarChar(32)
  distanceM Decimal? @map("distance_m") @db.Decimal(8, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  trip Trip         @relation(fields: [tripId], references: [id])
  stop DeliveryStop @relation(fields: [stopId], references: [id])

  @@map("geofence_events")
}

model NotificationEvent {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(64)
  title     String    @db.VarChar(200)
  body      String?   @db.Text
  status    String    @default("QUEUED") @db.VarChar(16)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  stopId    String?   @map("stop_id") @db.Uuid
  tripId    String?   @map("trip_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([stopId])
  @@index([tripId])
  @@map("notification_events")
}
